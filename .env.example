# ============================================================
#  ENV VARIABLES — Aoi AI Waifu (Railway / Docker)
#  Isi yang WAJIB di Railway Dashboard -> Variables
# ============================================================

# ---------------- WAJIB ----------------
GEMINI_API_KEY=isi_gemini_api_key_disini
ELEVENLABS_API_KEY=isi_elevenlabs_api_key_disini
VOICE_ID=hpp4J3VqNfWAUOO0d1Us

# ---------------- GEMINI (opsional) ----------------
GEMINI_MODEL=gemini-3.1-flash-lite
MAX_HISTORY=10

# ---------------- TTS / ElevenLabs (opsional) ----------------
TTS_MODEL=eleven_multilingual_v2
TTS_STABILITY=0.4
TTS_SIMILARITY=0.8

# ---------------- KARAKTER / PERSONA (opsional) ----------------
KARAKTER_NAMA=Aoi
KARAKTER_CREATOR=Jonathan
KARAKTER_DESKRIPSI=cewek yang lembut, manis, dan perhatian. Natural dan hangat - bukan robot.
KARAKTER_GAYA_NGOMONG=Santai dan natural kayak ngobrol sama orang yang udah kenal lama. Jangan pakai kalimat template atau basa-basi. Ekspresif tapi tidak lebay.
KARAKTER_RESPONSE_LEN=8-12

# ---------------- ANIMASI (opsional) ----------------
SMOOTH_STEPS=30
SMOOTH_INTERVAL=0.02
HOLD_INTERVAL=0.03
MOUTH_STEP_INTERVAL=0.03

# ---------------- VTUBE STUDIO (opsional) ----------------
# Kosongkan VTS_HOST kalau tidak pakai VTube Studio (avatar tetap render di browser).
# Isi dengan hostname Cloudflare Tunnel ke VTS lokal kalau mau sync ke VTS juga.
VTS_HOST=
VTS_PORT=8001
VTS_PLUGIN_NAME=AI_Waifu_Aoi
VTS_DEVELOPER=Jonathan

# ---------------- PARAM MAP OVERRIDE (opsional) ----------------
# Override mapping param internal -> Cubism param ID di model Aoi.
# Default sudah disesuaikan ke model AAA (aaa.cdi3.json):
#   MouthOpen    -> ParamMouthOpenY
#   MouthSmile   -> ParamMouthForm
#   CheekPuff    -> lianhong
#   BrowLeftY    -> ParamBrowLForm
#   BrowRightY   -> ParamBrowRForm
#   EyeOpenLeft  -> ParamEyeLOpen
#   EyeOpenRight -> ParamEyeROpen
#   EyeLeftX/EyeRightX -> ParamEyeBallX
#   EyeLeftY/EyeRightY -> ParamEyeBallY
#   TongueOut    -> Param68
#   FaceAngleX   -> ParamAngleX
#   FaceAngleY   -> ParamAngleY
#   FaceAngleZ   -> FacePositionZ
# Hanya isi kalau mau override, format: PARAM_MAP_<NamaInternal>=<CubismParamID> (atau NONE untuk matikan)
# PARAM_MAP_FaceAngry=NONE
